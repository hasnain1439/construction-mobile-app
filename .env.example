# Your PC's Wi-Fi IPv4 address (Windows: run `ipconfig`) so a phone on the same Wi-Fi can reach the API.
# Android emulator: http://10.0.2.2:4000/api/v1
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:4000/api/v1

# --- Observability (all optional; empty = off, nothing is sent) — see README → Observability ---
# Crash reporting (Sentry React Native project DSN).
EXPO_PUBLIC_SENTRY_DSN=
# Defaults: development in dev builds, production otherwise.
EXPO_PUBLIC_SENTRY_ENVIRONMENT=
# Empty = the native <bundle id>@<version>+<build> (matches the EAS source-map upload).
EXPO_PUBLIC_SENTRY_RELEASE=
# 0..1, default 0.1.
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# Product analytics (PostHog project API key + host, e.g. https://eu.i.posthog.com).
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Build-time only (EAS secrets, never in .env / git): SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT
# (optional SENTRY_URL for self-hosted) enable the Sentry config plugin + source-map upload.
